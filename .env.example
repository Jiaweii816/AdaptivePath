# Local database profiles are strict ownership boundaries. Prefer the launch
# commands below; they set all four variables as one unit and run on port 3000:
#   npm run dev              # disposable development scratch database (`try`)
#   npm run dev:iris         # Iris904's live learner database
#   npm run dev:interview    # resettable guest interview/demo database
#   npm run dev:try          # disposable development scratch database
# Do not point development/test traffic at dev.db. The runtime refuses a
# profile/database/handle mismatch before opening Prisma, FTS, or sqlite-vec.
DATABASE_URL="file:./dev.db"
PATTERNCOACH_DATABASE_PROFILE="iris"
PATTERNCOACH_MEMORY_ORIGIN="learner"
PATTERNCOACH_LOCAL_USER_HANDLE="Iris904"

# LLM #1 — diagnoseAndReply (Review 路径) — DeepSeek V4 (DeepSeek API)
LLM_REVIEW_BASE_URL="https://api.deepseek.com"
LLM_REVIEW_API_KEY=""
LLM_REVIEW_MODEL="deepseek-v4-flash"
LLM_REVIEW_THINKING_MODEL="deepseek-v4-pro"

# LLM #2 — chatReply agentic loop (Chat 路径) — DeepSeek V4 (DeepSeek API)
LLM_CHAT_BASE_URL="https://api.deepseek.com"
LLM_CHAT_API_KEY=""
LLM_CHAT_MODEL="deepseek-v4-flash"
LLM_CHAT_THINKING_MODEL="deepseek-v4-pro"

# Chat turn understanding. Unset defaults to deterministic V2 consumption.
# Use v2_shadow to compare without consuming, or legacy for rollback.
# TURN_UNDERSTANDING_MODE="v2_consume"
# Ambiguous V2 turns automatically use the Chat LLM semantic slow path when
# LLM_CHAT_API_KEY is configured. Set 0 for an explicit opt-out; tests and
# mock-provider runs remain classifier-free unless a classifier is injected.
# TURN_CLASSIFIER_ENABLED="0"

# Durable-write resolver rollout. Unset/"active" uses the tri-state resolver;
# "shadow" keeps legacy grants while tracing resolver differences.
# CHAT_REQUESTED_ACTION_RESOLVER_MODE="active"

# LLM #2b — InterviewerAgent mock interview turns — DeepSeek V4 Flash by default.
# Empty values fall back to the Chat LLM settings above.
LLM_INTERVIEW_BASE_URL=""
LLM_INTERVIEW_API_KEY=""
LLM_INTERVIEW_MODEL=""

# LLM #3 — MemoryAgent consolidation/reflection (后台) — Qwen3-8B (DashScope)
LLM_MEMORY_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MEMORY_API_KEY=""
LLM_MEMORY_MODEL="qwen3-8b"
# Qwen3.8-Flash supports DashScope strict JSON Schema; this is only for the
# semantic turn assembler, not the background MemoryAgent.
LLM_CHAT_ASSEMBLER_MODEL="qwen3.8-flash"

# Optional read-only Calendar MCP client for Campaign Strategist. Disabled by
# default. The endpoint must expose the calendar_freebusy tool over MCP
# Streamable HTTP and return only free/busy metadata; keep the token server-side.
CALENDAR_MCP_ENABLED="0"
CALENDAR_MCP_ENDPOINT=""
CALENDAR_MCP_ACCESS_TOKEN=""
# CALENDAR_MCP_TOOL_NAME="calendar_freebusy"
# CALENDAR_MCP_TIMEOUT_MS="5000"

# Optional explicit test/debug switches. Unset = real configured providers.
# CHAT_CONSOLIDATION_PROVIDER="mock"
# INTERVIEWER_PROVIDER="mock"
# REFLECTION_PROVIDER="mock"

# Embedding（可选；缺省时记忆检索显式降级为 FTS-only）
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_DIM="1024"

# Optional read-only Tavily search for public coding-interview variant discovery.
TAVILY_API_KEY=""

# Self-hosted local Piston API.
PISTON_URL="http://localhost:2000"
# Piston reads this when the container starts; default compose value is 16 MiB.
PISTON_OUTPUT_MAX_SIZE="16777216"

# Runtime Trace payload retention. Event/Run skeleton metrics are retained.
# TRACE_RETAIN_FULL_SESSIONS="20"
# TRACE_RETAIN_UNSCOPED_DAYS="30"
# TRACE_PRUNE_BATCH_SIZE="500"

# Product invariant guard is temporarily observe-only while advisory selected-suite
# evidence semantics are repaired. Set to enforce to restore reply replacement.
# CHAT_PRODUCT_INVARIANT_GUARD_MODE="enforce"

# Code runner provider: unset = LeetCode when LEETCODE_SESSION exists,
# otherwise Piston fallback for local demo development only.
# In production, set CODE_RUNNER_PROVIDER="lc" and fail fast if credentials are absent.
# CODE_RUNNER_PROVIDER="lc"

# LeetCode session cookie settings. Keep these server-side only.
LEETCODE_SITE="global"
LEETCODE_SESSION=""
LEETCODE_CSRF_TOKEN=""

# --- Proactive agent / MCP demo ---
# Email transport: file (default, writes a local preview) | resend
EMAIL_TRANSPORT="file"
RESEND_API_KEY=""
DAILY_COACH_USER="Iris904"
DAILY_COACH_TO="you@example.com"
DAILY_COACH_FROM="coach@patterncoach.local"
# node-cron expression and IANA timezone used by `npm run agent:daily:cron`.
DAILY_COACH_CRON="0 9 * * *"
DAILY_COACH_TIMEZONE="America/Chicago"
# OTel export backend (Phoenix OTLP HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:6006"
# Learning-experience recall Pilot is the default Chat path. It skips automatic
# Coach memory assembly and lets the Coach decide whether to call the read-only
# three-layer recall Tool. Set to 0 only for an immediate legacy rollback.
COACH_LEARNING_EXPERIENCE_RECALL_PILOT="1"

# Round 1 BFF (separate audit database; never an Agent/learner database).
BFF_PORT="8080"
BFF_JDBC_URL="jdbc:postgresql://postgres:5432/round1"
BFF_DB_USER="round1"
BFF_DB_PASSWORD=""
BFF_INTERNAL_TOKEN=""
NEXT_BASE_URL="http://next:3000"
# Enable only on the isolated hosted stack. Daily direct Next stays false.
BFF_PROXY_ENABLED="false"
NEXT_ALLOWED_HOSTS="next:3000"
# BFF protection defaults; per-route binding uses BFF_ROUTES_<ROUTE>_DEADLINESECONDS,
# CAPACITY and QUOTA (e.g. BFF_ROUTES_REVIEW_DEADLINESECONDS=180).
BFF_REQUEST_BYTES="4194304"
BFF_JSON_BYTES="16777216"
BFF_LINE_BYTES="16777216"
BFF_STREAM_BYTES="33554432"
BFF_CIRCUIT_WINDOW="20"
BFF_CIRCUIT_MINIMUM_CALLS="10"
BFF_CIRCUIT_FAILURE_PERCENT="50"
BFF_CIRCUIT_OPEN_SECONDS="30"
BFF_CIRCUIT_HALF_OPEN_CALLS="2"

# BFF Redis is advisory coordination only; no durable learner data.
BFF_REDIS_ADDRESS=redis://redis:6379
BFF_ENVIRONMENT=test
BFF_LEARNER=round1-test

# Isolated Round 1 stack only; create a separate env file outside Git.
# Never pass this example's learner DATABASE_URL/profile to Compose.
ROUND1_DATA_DIR=/home/iris/round1-data
ROUND1_PORT=8088
# ROUND1_ENV_FILE=/home/iris/round1-data/round1.env
# Set PISTON_URL=http://piston:2000 and --profile piston only when using the optional service.

# Exact environment bindings; shared group overrides apply to every member route.
# BFF_REVIEW_DEADLINE_SECONDS=180; CHAT=120; CLEAR=15; RUN=60;
# BFF_START_DEADLINE_SECONDS=120; RESPOND=120; SEND_CODE=120; RUN_CODE=60; COMPLETE=180.
# BFF_REVIEW_CAPACITY=2; BFF_CHAT_CAPACITY=1; BFF_CLEAR_CAPACITY=1;
# BFF_RUNNER_CAPACITY=2; BFF_INTERVIEW_CAPACITY=1.
# BFF_AI_QUOTA=10; BFF_RUNNER_QUOTA=30; BFF_CLEAR_QUOTA=30 (UTC minute, key TTL 120s).
