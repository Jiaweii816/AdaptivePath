  status                  String   @default("candidate")
  supportCount            Int      @default(0)
  counterCount            Int      @default(0)
  distinctProblemCount    Int      @default(0)
  distinctSessionCount    Int      @default(0)
  evidenceEventIdsJson    String   @default("[]")
  validatedAt             DateTime?
  invalidAt               DateTime?
  lastEvidenceAt          DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([memoryOrigin, kind, scopeKind, scopeKey, signalKey, preconditionHash, contractVersion])
  @@index([memoryOrigin, status, scopeKind, scopeKey, contractVersion])
  @@index([invalidAt])
}
