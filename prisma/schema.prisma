generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// JSON-like MVP payloads are stored as serialized strings to keep SQLite simple.
// The initial migration enables WAL for the local database file.

model User {
  id        String   @id @default(cuid())
  handle    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile                  UserProfile?
  problemTestCases         ProblemTestCase[]
  codeDrafts               CodeDraft[]
  reviewAttempts           ReviewAttempt[]
  practiceRunLogs          PracticeRunLog[]
  chatSessions             ChatSession[]
  problemHistories         ProblemHistory[]
  l1MemoryEvents           L1MemoryEvent[]
  l2MemoryFacts            L2MemoryFact[]
  hintProgresses           AlgorithmHintProgress[]
  memoryEpisodes           MemoryEpisode[]
  memoryActivityClusters   MemoryActivityCluster[]
  memoryClaimObservations  MemoryClaimObservation[]
  synthesisSlots           SynthesisSlot[]
  knowledgeNotes           KnowledgeNote[]
  mistakeBookEntries       MistakeBookEntry[]
  readinessGoals           ReadinessGoal[]
  plannerPlanItems         PlannerPlanItem[]
  plannerOutcomes          PlannerOutcome[]
  plannerDailyDoseItems    PlannerDailyDoseItem[]
  reviewSchedules          ReviewSchedule[]
  plannerProposals         PlannerProposal[]
  mockInterviewSessions    MockInterviewSession[]
  problemWorkspaceSessions ProblemWorkspaceSession[]
  agentTraceRuns           AgentTraceRun[]
  campaigns                Campaign[]
}

model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  displayName        String
  interviewGoal      String?
  preferredLanguages String   @default("[]")
  strongPatterns     String   @default("[]")
  weakPatterns       String   @default("[]")
  explanationStyle   String   @default("[]")
  outputPreferences  String   @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Problem {
  id                    String    @id @default(cuid())
  leetcodeNumber        Int?      @unique
  slug                  String    @unique
  title                 String
  difficulty            String?
  hot150Order           Int?
  hot150Section         String?
  officialUrl           String?
  statementMarkdown     String    @default("")
  examplesJson          String    @default("[]")
  constraintsJson       String    @default("[]")
  tags                  String    @default("[]")
  starterCodePython     String?
  starterCodeCpp        String?
  methodName            String
  inputContractJson     String    @default("{}")
  outputContractJson    String    @default("{}")
  isDemoSupported       Boolean   @default(true)
  localRunStatus        String    @default("not_ready")
  localRunStatusMessage String?
  localRunValidatedAt   DateTime?
  comparisonStrategy    String    @default("exact")
  comparisonConfigJson  String    @default("{}")
  contractKind          String    @default("pure_function")
  referenceSolutionHash String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  testCases                   ProblemTestCase[]
  codeDrafts                  CodeDraft[]
  reviewAttempts              ReviewAttempt[]
  practiceRunLogs             PracticeRunLog[]
  chatSessions                ChatSession[]
  problemHistories            ProblemHistory[]
  l1MemoryEvents              L1MemoryEvent[]
  l2MemoryFacts               L2MemoryFact[]
  hintProgresses              AlgorithmHintProgress[]
  memoryEpisodes              MemoryEpisode[]
  memoryActivityClusters      MemoryActivityCluster[]
  memoryClaimObservations     MemoryClaimObservation[]
  memoryEvidenceContributions MemoryEvidenceContribution[]
  mistakeBookEntries          MistakeBookEntry[]
  plannerPlanItems            PlannerPlanItem[]
  plannerOutcomes             PlannerOutcome[]
  plannerDailyDoseItems       PlannerDailyDoseItem[]
  reviewSchedules             ReviewSchedule[]
  mockInterviewSessions       MockInterviewSession[]
  mockInterviewCodeSnapshots  MockInterviewCodeSnapshot[]
  mockInterviewRunEvidences   MockInterviewRunEvidence[]
  problemWorkspaceSessions    ProblemWorkspaceSession[]
  agentTraceRuns              AgentTraceRun[]
}

model ProblemTestCase {
  id               String   @id @default(cuid())
  problemId        String
  userId           String?
  label            String
  inputJson        String
  expectedJson     String
  source           String   @default("sample")
  expectedSource   String   @default("seed")
  gtProvenance     String?
  validationStatus String   @default("unchecked")
  metadataJson     String   @default("{}")
  isVisible        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([userId])
}

model CodeDraft {
  id                  String   @id @default(cuid())
  userId              String
  problemId           String
  language            String
  content             String   @default("")
  selectedTestCaseIds String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  reviewAttempts  ReviewAttempt[]
  practiceRunLogs PracticeRunLog[]

  @@unique([userId, problemId, language])
  @@index([problemId])
}

model PracticeRunLog {
  id                   String   @id @default(cuid())
  userId               String
  problemId            String
  codeDraftId          String?
  language             String
  codeSnapshot         String?
  codeHash             String?
  executionFingerprint String?
  runOrdinal           Int
  selectedTestCaseIds  String   @default("[]")
  status               String
  passedCount          Int      @default(0)
  totalCount           Int      @default(0)
  summary              String
  provider             String   @default("unknown")
  rawResultJson        String   @default("{}")
  durationMs           Int?
  createdAt            DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  codeDraft CodeDraft? @relation(fields: [codeDraftId], references: [id], onDelete: SetNull)

  @@index([userId, problemId])
  @@index([codeDraftId])
  @@index([codeHash])
  @@index([executionFingerprint])
  @@index([createdAt])
}

model ReviewAttempt {
  id                  String   @id @default(cuid())
  userId              String
  problemId           String
  chatSessionId       String
  codeDraftId         String?
  language            String
  userState           String?
  userQuestion        String?
  codeSnapshot        String   @default("")
  selectedTestCaseIds String   @default("[]")
  selectedTestsJson   String   @default("[]")
  coachReplyMarkdown  String?
  memoryOrigin        String   @default("legacy_unknown")
  createdAt           DateTime @default(now())

  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem                     Problem                      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  chatSession                 ChatSession                  @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  codeDraft                   CodeDraft?                   @relation(fields: [codeDraftId], references: [id], onDelete: SetNull)
  runEvidences                RunEvidence[]
  diagnosisResult             DiagnosisResult?
  chatMessages                ChatMessage[]
  problemHistories            ProblemHistory[]
  l1MemoryEvents              L1MemoryEvent[]
  l2MemoryFacts               L2MemoryFact[]
  mistakeBookEntries          MistakeBookEntry[]
  plannerOutcome              PlannerOutcome?
  memoryActivityCluster       MemoryActivityCluster?
  memoryEvidenceContributions MemoryEvidenceContribution[]
  campaignTaskItemAttempts    CampaignTaskItemAttempt[]

  @@index([userId, problemId])
  @@index([chatSessionId])
  @@index([codeDraftId])
  @@index([createdAt])
  @@index([memoryOrigin, createdAt])
}

model RunEvidence {
  id                   String   @id @default(cuid())
  reviewAttemptId      String?
  chatSessionId        String?
  source               String   @default("review")
  toolCallId           String?
  codeHash             String?
  executionFingerprint String?
  status               String
  passedCount          Int      @default(0)
  failedCount          Int      @default(0)
  durationMs           Int?
  stdout               String?
  stderr               String?
  actualOutput         String?
  expectedOutput       String?
  firstFailedCaseJson  String?
  rawResultJson        String   @default("{}")
  memoryOrigin         String   @default("legacy_unknown")
  createdAt            DateTime @default(now())

  reviewAttempt ReviewAttempt? @relation(fields: [reviewAttemptId], references: [id], onDelete: Cascade)
  chatSession   ChatSession?   @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  @@index([reviewAttemptId])
  @@index([chatSessionId])
  @@index([codeHash])
  @@index([executionFingerprint])
  @@index([source])
  @@index([memoryOrigin, createdAt])
}

model DiagnosisResult {
  id                        String   @id @default(cuid())
  reviewAttemptId           String   @unique
  diagnosisJson             String   @default("{}")
  memoryUpdateCandidateJson String   @default("{}")
  mistakeTags               String   @default("[]")
  skillTags                 String   @default("[]")
  userIssueSummary          String?
  coachSummary              String?
  selfCheckQuestion         String?
  selfCheckAnswer           String?
  createdAt                 DateTime @default(now())

  reviewAttempt ReviewAttempt @relation(fields: [reviewAttemptId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id                        String    @id @default(cuid())
  userId                    String
  problemId                 String
  title                     String?
  primaryLanguage           String?
  isActive                  Boolean   @default(true)
  rollingSummary            String?
  lastConsolidatedMessageId String?
  sessionPlanJson           String?
  clearedBeforeSequence     Int       @default(0)
  clearedAt                 DateTime?
  memoryOrigin              String    @default("legacy_unknown")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem                Problem                 @relation(fields: [problemId], references: [id], onDelete: Cascade)
  reviewAttempts         ReviewAttempt[]
  messages               ChatMessage[]
  problemHistories       ProblemHistory[]
  l1MemoryEvents         L1MemoryEvent[]
  runEvidences           RunEvidence[]
  memoryEpisodes         MemoryEpisode[]
  memoryActivityClusters MemoryActivityCluster[]
  mistakeBookEntries     MistakeBookEntry[]

  @@unique([userId, problemId, memoryOrigin])
  @@index([problemId])
  @@index([memoryOrigin, updatedAt])
}

model ChatMessage {
  id              String   @id @default(cuid())
  sessionId       String
  reviewAttemptId String?
  role            String
  contentMarkdown String
  metadataJson    String   @default("{}")
  sequence        Int
  memoryOrigin    String   @default("legacy_unknown")
  createdAt       DateTime @default(now())

  session       ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewAttempt ReviewAttempt? @relation(fields: [reviewAttemptId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@index([reviewAttemptId])
  @@index([memoryOrigin, createdAt])
}

model ProblemHistory {
  id                  String   @id @default(cuid())
  userId              String
  problemId           String
  reviewAttemptId     String   @unique
  chatSessionId       String
  language            String
  userState           String?
  problemTags         String   @default("[]")
  runStatus           String
  failedCaseSummary   String?
  userIssueSummary    String?
  coachSummary        String?
  memoryUpdateSummary String?
  nextRecommendation  String?
  durationSeconds     Int?
  memoryOrigin        String   @default("legacy_unknown")
  createdAt           DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  reviewAttempt  ReviewAttempt   @relation(fields: [reviewAttemptId], references: [id], onDelete: Cascade)
  chatSession    ChatSession     @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  plannerOutcome PlannerOutcome?

  @@index([userId, problemId])
  @@index([chatSessionId])
  @@index([createdAt])
  @@index([memoryOrigin, createdAt])
}

model L1MemoryEvent {
  id              String   @id @default(cuid())
  userId          String
  problemId       String?
  chatSessionId   String?
  reviewAttemptId String?
  eventType       String
  eventJson       String   @default("{}")
  content         String?
  source          String?
  memoryOrigin    String   @default("legacy_unknown")
  traceRunId      String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem       Problem?       @relation(fields: [problemId], references: [id], onDelete: SetNull)
  chatSession   ChatSession?   @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  reviewAttempt ReviewAttempt? @relation(fields: [reviewAttemptId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([problemId])
  @@index([chatSessionId])
  @@index([reviewAttemptId])
  @@index([memoryOrigin, occurredAt])
  @@index([traceRunId])
}

model ProblemWorkspaceSession {
  id                String    @id @default(cuid())
  userId            String
  problemId         String
  browserInstanceId String
  activeIdentityKey String?   @unique
  startTrigger      String
  captureLevel      String
  memoryOrigin      String    @default("legacy_unknown")
  foregroundStatus  String    @default("active")
  backgroundStatus  String    @default("idle")
  startedAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  foregroundEndedAt DateTime?
  endReason         String?
  settledAt         DateTime?
  nextSeq           Int       @default(1)
  nextTurnOrdinal   Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem                  Problem                   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  traceRuns                AgentTraceRun[]
  traceEvents              AgentTraceEvent[]
  backgroundJobs           BackgroundJob[]
  campaignTaskItemAttempts CampaignTaskItemAttempt[]

  @@index([userId, problemId, foregroundStatus])
  @@index([userId, startedAt])
  @@index([memoryOrigin, startedAt])
}

model AgentTraceRun {
  id                      String    @id
  userId                  String
  problemId               String?
  workspaceSessionId      String?
  parentTraceRunId        String?
  originatingTraceRunId   String?
  turnOrdinal             Int?
  originatingTurnOrdinal  Int?
  path                    String
  actionKind              String?
  memoryOrigin            String    @default("legacy_unknown")
  status                  String    @default("running")
  processInstanceId       String
  startedAt               DateTime  @default(now())
  endedAt                 DateTime?
  durationMs              Int?
  providerInputTokens     Int?
  providerOutputTokens    Int?
  providerTotalTokens     Int?
  providerReasoningTokens Int?
  providerCachedTokens    Int?
  estimatedCostUsd        Float?
  pricingVersion          String?
  pricingStatus           String    @default("not_applicable")
  unpricedLlmCallCount    Int       @default(0)
  llmCallCount            Int       @default(0)
  toolCallCount           Int       @default(0)
  errorCount              Int       @default(0)
  traceOverheadMs         Int?
  traceCompleteness       String    @default("open")
  finalFlushAt            DateTime?
  reviewAttemptId         String?
  chatSessionId           String?
  runId                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem                  Problem?                 @relation(fields: [problemId], references: [id], onDelete: SetNull)
  workspaceSession         ProblemWorkspaceSession? @relation(fields: [workspaceSessionId], references: [id], onDelete: Cascade)
  parentTraceRun           AgentTraceRun?           @relation("AgentTraceRunParent", fields: [parentTraceRunId], references: [id], onDelete: SetNull)
  childTraceRuns           AgentTraceRun[]          @relation("AgentTraceRunParent")
  originatingTraceRun      AgentTraceRun?           @relation("AgentTraceRunOrigin", fields: [originatingTraceRunId], references: [id], onDelete: SetNull)
  originatedTraceRuns      AgentTraceRun[]          @relation("AgentTraceRunOrigin")
  traceEvents              AgentTraceEvent[]        @relation("AgentTraceEventRun")
  parentTraceEvents        AgentTraceEvent[]        @relation("AgentTraceEventParentRun")
  originatedBackgroundJobs BackgroundJob[]          @relation("BackgroundJobOrigin")
  childBackgroundJob       BackgroundJob?           @relation("BackgroundJobChild")

  @@unique([workspaceSessionId, turnOrdinal])
  @@index([workspaceSessionId, startedAt])
  @@index([userId, startedAt])
  @@index([problemId])
  @@index([parentTraceRunId])
  @@index([originatingTraceRunId])
  @@index([memoryOrigin, startedAt])
}

model BackgroundJob {
  id                    String    @id @default(cuid())
  dedupeKey             String?   @unique
  workspaceSessionId    String?
  originatingTraceRunId String
  parentTraceRunId      String?
  traceRunId            String?   @unique
  processInstanceId     String
  kind                  String
  memoryOrigin          String    @default("legacy_unknown")
  status                String    @default("pending")
  enqueuedAt            DateTime  @default(now())
  startedAt             DateTime?
  endedAt               DateTime?
  failureReason         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspaceSession    ProblemWorkspaceSession? @relation(fields: [workspaceSessionId], references: [id], onDelete: Cascade)
  originatingTraceRun AgentTraceRun            @relation("BackgroundJobOrigin", fields: [originatingTraceRunId], references: [id], onDelete: Cascade)
  traceRun            AgentTraceRun?           @relation("BackgroundJobChild", fields: [traceRunId], references: [id], onDelete: SetNull)

  @@index([workspaceSessionId, status])
  @@index([processInstanceId, status, enqueuedAt])
  @@index([originatingTraceRunId])
  @@index([parentTraceRunId])
  @@index([memoryOrigin, status])
}

model AgentTraceEvent {
  id                      String    @id @default(cuid())
  eventId                 String    @unique
  eventDigest             String
  seq                     Int?
  workspaceSessionId      String?
  traceRunId              String
  parentTraceRunId        String?
  turnOrdinal             Int?
  stepId                  String?
  parentStepId            String?
  stepIndex               Int?
  agentIteration          Int?
  path                    String
  stage                   String
  kind                    String
  title                   String
  status                  String
  occurredAt              DateTime  @default(now())
  clientOccurredAt        DateTime?
  startedAt               DateTime?
  endedAt                 DateTime?
  durationMs              Int?
  model                   String?
  responseModel           String?
  providerInputTokens     Int?
  providerOutputTokens    Int?
  providerTotalTokens     Int?
  providerReasoningTokens Int?
  providerCachedTokens    Int?
  usageSource             String?
  usageMissingReason      String?
  estimatedTokens         Int?
  estimatedCostUsd        Float?
  pricingVersion          String?
  pricingStatus           String?
  memoryRssBytes          Int?
  memoryHeapUsedBytes     Int?
  resourceScope           String?
  detailLevel             String    @default("summary")
  payloadState            String    @default("unavailable")
  redactedFieldsJson      String?
  truncatedFieldsJson     String?
  unavailableFieldsJson   String?
  metadataJson            String?
  createdAt               DateTime  @default(now())

  workspaceSession ProblemWorkspaceSession? @relation(fields: [workspaceSessionId], references: [id], onDelete: Cascade)
  traceRun         AgentTraceRun            @relation("AgentTraceEventRun", fields: [traceRunId], references: [id], onDelete: Cascade)
  parentTraceRun   AgentTraceRun?           @relation("AgentTraceEventParentRun", fields: [parentTraceRunId], references: [id], onDelete: SetNull)
  payload          AgentTracePayload?

  @@unique([workspaceSessionId, seq])
  @@index([traceRunId, stepIndex])
  @@index([parentTraceRunId])
}

model AgentTracePayload {
  id                 String   @id @default(cuid())
  traceEventId       String   @unique
  workspaceSessionId String?
  promptJson         String?
  inputJson          String?
  outputJson         String?
  retrievalJson      String?
  stateDeltaJson     String?
  memoryDeltaJson    String?
  detailMetadataJson String?
  stdout             String?
  stderr             String?
  byteSize           Int      @default(0)
  createdAt          DateTime @default(now())

  traceEvent AgentTraceEvent @relation(fields: [traceEventId], references: [id], onDelete: Cascade)

  @@index([workspaceSessionId])
}

model L2MemoryFact {
  id                    String   @id @default(cuid())
  userId                String
  problemId             String?
  sourceReviewAttemptId String?
  factType              String
  tag                   String
  label                 String?
  value                 String?
  confidence            Float    @default(0.5)
  evidenceCount         Int      @default(1)
  lastEvidenceSummary   String?
  lastSeenAt            DateTime @default(now())
  status                String   @default("active")
  source                String   @default("review_diagnosis")
  memoryOrigin          String   @default("legacy_unknown")
  evidenceTraceIds      String   @default("[]")
  contradictionSummary  String?
  validationJson        String   @default("{}")
  clusterKey            String?
  claimText             String?
  polarity              String?
  scopeJson             String   @default("{}")
  mechanismKeysJson     String   @default("[]")
  integrityVersion      Int      @default(1)
  retrievalText         String?
  retrievalTextVersion  Int      @default(0)
  retrievalInputHash    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem               Problem?                     @relation(fields: [problemId], references: [id], onDelete: SetNull)
  sourceReviewAttempt   ReviewAttempt?               @relation(fields: [sourceReviewAttemptId], references: [id], onDelete: SetNull)
  claimRelations        MemoryClaimRelation[]
  evidenceContributions MemoryEvidenceContribution[]

  @@unique([userId, factType, tag, memoryOrigin])
  @@unique([userId, clusterKey, memoryOrigin])
  @@index([problemId])
  @@index([sourceReviewAttemptId])
  @@index([lastSeenAt])
  @@index([memoryOrigin, status, lastSeenAt])
}

model AlgorithmHintProgress {
  id           String   @id @default(cuid())
  userId       String
  problemId    String
  currentLevel Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId])
}

model MemoryEpisode {
  id                String    @id @default(cuid())
  userId            String
  problemId         String?
  chatSessionId     String?
  activityClusterId String?
  kind              String
  title             String
  summary           String
  outcome           String
  tags              String    @default("[]")
  salience          Float     @default(0.5)
  sourceTraceIds    String    @default("[]")
  memoryOrigin      String    @default("legacy_unknown")
  retrievalText     String?
  retrievalTextVersion Int   @default(0)
  retrievalInputHash String?
  createdAt         DateTime  @default(now())

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem           Problem?                 @relation(fields: [problemId], references: [id], onDelete: SetNull)
  chatSession       ChatSession?             @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  activityCluster   MemoryActivityCluster?   @relation(fields: [activityClusterId], references: [id], onDelete: SetNull)
  claimObservations MemoryClaimObservation[]

  @@index([userId, createdAt])
  @@index([userId, kind])
  @@index([memoryOrigin, createdAt])
  @@index([activityClusterId])
}

model MemoryActivityCluster {
  id                  String    @id @default(cuid())
  userId              String
  problemId           String?
  chatSessionId       String?
  rootReviewAttemptId String?   @unique
  clusterKind         String
  status              String    @default("open")
  sourceKey           String
  memoryOrigin        String    @default("legacy_unknown")
  startedAt           DateTime
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem               Problem?                     @relation(fields: [problemId], references: [id], onDelete: SetNull)
  chatSession           ChatSession?                 @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  rootReviewAttempt     ReviewAttempt?               @relation(fields: [rootReviewAttemptId], references: [id], onDelete: SetNull)
  items                 MemoryActivityItem[]
  extractionReceipts    MemoryExtractionReceipt[]
  episodes              MemoryEpisode[]
  claimObservations     MemoryClaimObservation[]
  evidenceContributions MemoryEvidenceContribution[]

  @@unique([userId, sourceKey, memoryOrigin])
  @@index([userId, startedAt])
  @@index([problemId])
  @@index([chatSessionId])
  @@index([memoryOrigin, status, startedAt])
}

model MemoryActivityItem {
  id                String   @id @default(cuid())
  activityClusterId String
  sourceType        String
  sourceId          String
  ordinal           Int
  role              String?
  occurredAt        DateTime
  messageSequence   Int?
  contentHash       String?
  metadataJson      String   @default("{}")
  createdAt         DateTime @default(now())

  activityCluster MemoryActivityCluster @relation(fields: [activityClusterId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@unique([activityClusterId, ordinal])
  @@index([activityClusterId, occurredAt])
}

model MemoryExtractionReceipt {
  id                String    @id @default(cuid())
  activityClusterId String
  extractorVersion  String
  status            String    @default("queued")
  inputHash         String?
  outputHash        String?
  noSemanticReason  String?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activityCluster MemoryActivityCluster @relation(fields: [activityClusterId], references: [id], onDelete: Cascade)

  @@unique([activityClusterId, extractorVersion])
  @@index([status, createdAt])
}

model MemoryClaimObservation {
  id                String   @id @default(cuid())
  userId            String
  activityClusterId String
  problemId         String?
  episodeId         String?
  claimType         String
  claimText         String
